# ===== Mediateka backend =====
PORT=8080

# Adres frontendu. Kilka adresów rozdziel przecinkami.
# Przykład: https://dariuszzarosa.github.io,http://localhost:5173
ALLOWED_ORIGINS=https://dzarosa.github.io,http://localhost:5173

# Hasła NIE trafiają już do HTML / JavaScript strony.
GROUP_PASSWORD=USTAW_NOWE_HASLO_GRUPOWE
ADMIN_PASSWORD=USTAW_NOWE_HASLO_ADMINA

# Długie losowe sekrety, min. 32 znaki.
AUTH_SECRET=WKLEJ_DLUGI_LOSOWY_SEKRET
MEDIA_SIGNING_SECRET=WKLEJ_DRUGI_DLUGI_LOSOWY_SEKRET

# OAuth jednego wspólnego konta Google. Uczestnicy Mediateki NIE logują się do Google.
# Backend sprawdza, że refresh token rzeczywiście należy do tego adresu.
GOOGLE_OWNER_EMAIL=reisekoreajapan2026@gmail.com
GOOGLE_CLIENT_ID=782690034922-rmt9neomk1ivupit7kig7frilnabcj3m.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx

# Skrypt auth:google utworzy folder i wypisze jego ID.
DRIVE_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxx
DRIVE_FOLDER_NAME=Korea_Japonia_2026

# Domyślnie 20 GiB na pojedynczy plik.
MAX_UPLOAD_BYTES=21474836480

# Sesja Mediateki i podpisane linki do prywatnych plików.
SESSION_HOURS=720
MEDIA_URL_HOURS=24
